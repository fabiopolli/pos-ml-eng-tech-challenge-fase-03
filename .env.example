# Application
MODEL_PATH=models/YYYYMMDDTHHMMSSZ-input_hash/model.joblib
LOG_LEVEL=INFO

# Tip: do not hand-edit this file. Use the bootstrap helper instead:
#   uv run python scripts/bootstrap_observability_overlay.py
# It auto-detects the latest model version under models/ and generates
# secrets with secrets.token_urlsafe(32).

# Production API container
API_MODEL_PATH=/models/YYYYMMDDTHHMMSSZ-input_hash/model.joblib
TRIAGE_ML_API_KEY_SERVICE=
TRIAGE_ML_API_KEY_DOCTOR=
TRIAGE_ML_API_KEY_PATIENT=
TRIAGE_ML_LOG_LEVEL=INFO
TRIAGE_ML_RATELIMIT_DEFAULT=60/minute
TRIAGE_ML_RATELIMIT_PREDICT=30/minute

# Services
API_PORT=8000
PORTAL_PORT=8501
DEV_DASHBOARD_PORT=8502
TRIAGE_ML_DASHBOARD_DOCTOR_USERNAME=medico-demo
TRIAGE_ML_DASHBOARD_DOCTOR_PASSWORD=
TRIAGE_ML_DASHBOARD_PATIENT_USERNAME=paciente-demo
TRIAGE_ML_DASHBOARD_PATIENT_PASSWORD=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Optimization/observability overlay (infra/docker-compose.yml)
MODEL_VERSION=YYYYMMDDTHHMMSSZ-input_hash
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
TRIAGE_ML_MODEL_VARIANT=sklearn
TRIAGE_ALLOW_PUBLIC_OBSERVABILITY=false

# Technical dashboard (compose profile "dev"; isolates dev traffic from prod)
TRIAGE_ML_DEV_API_URL=http://api-dev:8000
TRIAGE_ML_DEV_API_KEY_DOCTOR=
TRIAGE_ML_DEV_API_KEY_SERVICE=

# Airflow retraining (optional; not used by API or fronts)
AIRFLOW_PORT=8080
DATA_REPOSITORY_URL=https://dagshub.com/deniscelclaro/pos-ml-eng-tech-challenge-fase-03.git
DATA_REPOSITORY_BRANCH=main
DATASET_RELATIVE_PATH=data/medical_tc_train.csv
# Required by the DagsHub Git endpoint, including for public repositories.
# Create a read-only token in DagsHub; do not use your account password here.
DAGSHUB_USERNAME=
DAGSHUB_USER_TOKEN=
# Set TRIAGE_REQUIRE_AUTH=true when the DagsHub repository is private; the
# airflow entrypoint will fail fast if credentials are missing.
TRIAGE_REQUIRE_AUTH=false
TRIAGE_OPTIMIZATION_ENABLED=false
TRIAGE_DATASET_SLICES=5000,6000,7000
